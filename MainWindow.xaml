<Window x:Class="ToolTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ToolTest"
        mc:Ignorable="d"
        Title="日報管理ツール" Height="500" Width="738"
        Background="#F5F6F7" UseLayoutRounding="True" ResizeMode="NoResize">

    <Window.DataContext>
        <local:ToolViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <local:BindingProxy x:Key="Tool" Data="{Binding}"/>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#DDD"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#0078D4"/>
                    <Setter Property="Background" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InsertionLine" TargetType="Border">
            <Setter Property="Height" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="0,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0078D4"/>
                    <Setter Property="Height" Value="4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <LinearGradientBrush x:Key="CategoryHeaderBrush" EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#F9F9F9" Offset="0"/>
            <GradientStop Color="#F0F0F0" Offset="1"/>
        </LinearGradientBrush>

        <ContextMenu x:Key="ItemMenu">
            <MenuItem Header="アイテム追加"
              Command="{Binding Data.AddItem, Source={StaticResource Tool}}"
              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="アイテム削除"
              Command="{Binding Data.RemoveItem, Source={StaticResource Tool}}"
              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="カテゴリ追加"
              Command="{Binding Data.AddCategory, Source={StaticResource Tool}}"/>
            <MenuItem Header="カテゴリ削除"
              Command="{Binding Data.RemoveCategory, Source={StaticResource Tool}}"
              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="STRUCTURE" FontSize="11" FontWeight="Bold" Foreground="#888" Margin="15,15,15,5"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10,0">
                <ItemsControl ItemsSource="{Binding Value}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:Item}">
                            <StackPanel Margin="0,0,0,15">
                                <Border Background="{StaticResource CategoryHeaderBrush}" 
                                        CornerRadius="4" Padding="5" 
                                        ContextMenu="{StaticResource ItemMenu}">
                                    <DockPanel>
                                        <local:EditableTextBox Text=" ⠿ " Foreground="#AAA" Cursor="SizeAll" Margin="5,0" FontSize="14" IsReadOnly="True" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Name}" FontWeight="Bold" Foreground="#333" FontSize="13" Style="{StaticResource ModernTextBox}"/>
                                    </DockPanel>
                                </Border>

                                <TreeView ItemsSource="{Binding Items}" Margin="15,5,0,0" BorderThickness="0" Background="Transparent">
                                    <TreeView.Resources>
                                        <HierarchicalDataTemplate DataType="{x:Type local:Item}" ItemsSource="{Binding Items}">
                                            <local:ItemLeaf Item="{Binding}"
                                                            TextBoxStyle="{StaticResource ModernTextBox }"/>
                                        </HierarchicalDataTemplate>
                                    </TreeView.Resources>
                                </TreeView>

                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Button Grid.Row="2" Content="+ Add New Category" 
                    Command="{Binding AddCategory}" 
                    Margin="15" Padding="10" 
                    Background="#0078D4" Foreground="White" FontWeight="SemiBold">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <Border Grid.Column="1" Background="#F5F6F7">
            <DockPanel LastChildFill="True">
                <Grid DockPanel.Dock="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="Btn_Update" Content="更新" Click="Btn_Update_TextUpdate"/>
                    <Button Grid.Column="1" x:Name="Btn_Copy" Content="コピー" Click="Btn_Copy_TextCopy"/>
                </Grid>

                <TextBox x:Name="Data" Text="No Item Selected" FontSize="18" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>